{
  "name": "sgm-desktop-mobile",
  "version": "0.1.0",
  "private": true,
  "description": "SGM Desk (Windows) and SGM Pocket (Android/iOS): inventory and point of sale for Sibugay Gas Marketing.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "desk": "npm run dev --workspace @sgm/desk",
    "desk:web": "npm run web --workspace @sgm/desk",
    "desk:build": "npm run build --workspace @sgm/desk",
    "desk:dist": "npm run dist --workspace @sgm/desk",
    "desk:release": "node scripts/release.mjs desk",
    "pocket": "npm run start --workspace @sgm/pocket",
    "pocket:android": "npm run android --workspace @sgm/pocket",
    "pocket:release": "node scripts/release.mjs pocket",
    "test": "npm run test --workspace @sgm/core",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "ocr:models": "node scripts/fetch-ocr-models.mjs",
    "postinstall": "patch-package"
  },
  "engines": {
    "node": ">=22.13"
  },
  "devDependencies": {
    "patch-package": "^8.0.1"
  }
}
