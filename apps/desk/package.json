{
  "name": "@sgm/desk",
  "version": "0.1.0",
  "private": true,
  "description": "SGM Desk: the Windows app for Sibugay Gas Marketing.",
  "author": "Sibugay Gas Marketing",
  "main": "expo-router/entry",
  "scripts": {
    "web": "expo start --web",
    "dev": "node scripts/dev.mjs",
    "build:web": "expo export --platform web --output-dir dist --clear",
    "build:electron": "node scripts/build-electron.mjs",
    "build": "npm run build:web && npm run build:electron",
    "start:electron": "electron build/app",
    "dist": "npm run build && electron-builder --win nsis",
    "dist:dir": "npm run build && electron-builder --dir",
    "typecheck": "tsc --noEmit && tsc --noEmit -p electron"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.16",
    "@expo/vector-icons": "^15.0.2",
    "@sgm/core": "*",
    "@sgm/ui": "*",
    "expo": "~57.0.28",
    "expo-constants": "~57.0.21",
    "expo-font": "~57.0.4",
    "expo-linking": "~57.0.12",
    "expo-router": "~57.0.26",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@expo/env": "~2.4.3",
    "@types/node": "^24.19.2",
    "@types/react": "~19.2.2",
    "electron": "44.7.0",
    "electron-builder": "^26.17.0",
    "electron-updater": "^6.8.10",
    "esbuild": "^0.28.2",
    "onnxruntime-node": "^1.30.0",
    "typescript": "~6.0.3"
  }
}
