{
  "expo": {
    "name": "SGM Pocket",
    "slug": "sgm-pocket",
    "version": "1.2.1",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/d8388113-5852-4eb3-9775-4897a6bb816a"
    },
    "orientation": "default",
    "icon": "./assets/icon.png",
    "scheme": "sgmpocket",
    "userInterfaceStyle": "automatic",
    "platforms": [
      "android",
      "ios"
    ],
    "ios": {
      "bundleIdentifier": "ph.sibugaygas.sgmpocket",
      "supportsTablet": true
    },
    "android": {
      "package": "ph.sibugaygas.sgmpocket",
      "versionCode": 5,
      "permissions": [
        "android.permission.REQUEST_INSTALL_PACKAGES"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#EAF2FF"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "backgroundColor": "#EAF2FF"
        }
      ],
      "expo-asset",
      [
        "expo-image-picker",
        {
          "cameraPermission": "SGM Pocket uses the camera to scan handwritten receipts into a sale.",
          "photosPermission": "SGM Pocket opens the receipt photos you choose so it can scan them into a sale.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d8388113-5852-4eb3-9775-4897a6bb816a"
      }
    },
    "owner": "sazoverse"
  }
}
