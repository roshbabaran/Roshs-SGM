# The SGM server (Supabase) that every release build talks to, so a release never falls back to the
# built-in demo server. "expo export" and EAS read this for production builds; development reads only
# .env.local (no address there means the demo server). A .env.local address still wins over this file,
# and "npm run desk:release" / "pocket:release" refuse a build that doesn't contain this address.
# The address is not a secret; tokens and keys never go in this file.
EXPO_PUBLIC_API_URL=https://cmpyttciealvhgkpuhoq.supabase.co/functions/v1/api
